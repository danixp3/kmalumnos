{
  "name": "kmalumnos",
  "version": "1.25.0",
  "description": "Gestión de kilómetros de prácticas para autoescuela",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "jest",
    "dist": "electron-builder",
    "smoke": "electron scripts/smoke-ui.js",
    "fuzz": "electron scripts/fuzz-ui.js",
    "barrido": "electron scripts/barrido-visual.js",
    "test:api": "node --import ./web-remote/tests/register.mjs --test web-remote/tests/api.test.mjs"
  },
  "build": {
    "appId": "com.kmalumnos.app",
    "productName": "AulaMovil",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "db.js",
      "db/**/*",
      "sync.js",
      "utils-ficheros.js",
      "fichas-dgt.js",
      "assets/**/*",
      "fonts/**/*",
      "index.html",
      "styles.css",
      "icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "runAfterFinish": true
    },
    "publish": {
      "provider": "github",
      "owner": "danixp3",
      "repo": "kmalumnos"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "jest": "^30.4.2",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.3",
    "electron-updater": "^6.8.9",
    "mdb-reader": "^3.2.0",
    "pdf-lib": "^1.17.1",
    "ws": "^8.21.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
