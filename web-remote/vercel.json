{
  "rewrites": [
    {
      "source": "/api/hoy",
      "destination": "/api/movil?op=hoy"
    },
    {
      "source": "/api/iniciar-practica",
      "destination": "/api/movil?op=iniciar-practica"
    },
    {
      "source": "/api/finalizar-practica",
      "destination": "/api/movil?op=finalizar-practica"
    },
    {
      "source": "/api/firmar-practica",
      "destination": "/api/movil?op=firmar-practica"
    },
    {
      "source": "/api/cancelar-practica",
      "destination": "/api/movil?op=cancelar-practica"
    },
    {
      "source": "/api/config",
      "destination": "/api/movil?op=config"
    },
    {
      "source": "/api/calendario",
      "destination": "/api/movil?op=calendario"
    },
    {
      "source": "/api/practica-detalle",
      "destination": "/api/movil?op=practica-detalle"
    },
    {
      "source": "/api/anotar-practica",
      "destination": "/api/movil?op=anotar-practica"
    },
    {
      "source": "/api/firma-profesor",
      "destination": "/api/movil?op=firma-profesor"
    },
    {
      "source": "/api/coche-profesor",
      "destination": "/api/movil?op=coche-profesor"
    },
    {
      "source": "/api/avisos",
      "destination": "/api/movil?op=avisos"
    },
    {
      "source": "/api/avisos-enviar",
      "destination": "/api/movil?op=avisos-enviar"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
